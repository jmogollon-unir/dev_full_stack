# URL base de la API. Déjala VACÍA (o sin definir) para usar el mismo origen:
#  - en producción (JAR de Spring Boot) el front y la API salen del mismo servidor
#  - con "npm run dev" Vite reenvía /api a http://localhost:8080 (ver vite.config.js)
# Solo defínela si la API está en otro servidor, p. ej. VITE_API_URL=http://localhost:8080
VITE_API_URL=
